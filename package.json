{
  "name": "ariadne",
  "version": "0.0.1",
  "description": "Seguimiento de alumnos, objetivos trimestrales y documentos para orientación",
  "author": "Ariadne",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never && npm run zip:win",
    "zip:win": "cd dist && rm -f Ariadne-*-windows.zip && mv win-unpacked Ariadne && zip -qrX \"Ariadne-$npm_package_version-windows.zip\" Ariadne -x '*.DS_Store' && mv Ariadne win-unpacked"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "es.ariadne.escritorio",
    "productName": "Ariadne",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/binding.gyp"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*.node",
        "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
