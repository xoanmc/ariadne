{
  "name": "ariadne",
  "version": "0.0.1",
  "description": "Prueba de viabilidad del empaquetado (T0.1)",
  "author": "Ariadne",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "es.ariadne.escritorio",
    "productName": "Ariadne",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ariadne"
    }
  }
}
