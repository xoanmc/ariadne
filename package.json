{
  "name": "ariadne",
  "version": "0.0.1",
  "description": "Prueba de viabilidad del empaquetado (T0.1)",
  "author": "Ariadne",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never && npm run zip:win",
    "zip:win": "cd dist && rm -f Ariadne-*-windows.zip && mv win-unpacked Ariadne && zip -qrX \"Ariadne-$npm_package_version-windows.zip\" Ariadne -x '*.DS_Store' && mv Ariadne win-unpacked"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "es.ariadne.escritorio",
    "productName": "Ariadne",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
